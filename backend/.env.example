# Account action links point to the Flutter web app. Use HTTPS when published.
APP_WEB_URL=http://localhost:8080
# disabled | local (Mailpit, never sends externally) | smtp
MAIL_MODE=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
