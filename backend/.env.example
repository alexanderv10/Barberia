DATABASE_URL=postgresql://barberia:CHANGE_ME@localhost:5432/barberia?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SHOP_TIMEZONE=America/Guayaquil
